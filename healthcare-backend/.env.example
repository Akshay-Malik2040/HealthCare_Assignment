# ==============================================================================
# Healthcare Management Backend - Environment Configuration Template
# Copy this file to .env and configure for your local or cloud environment.
# DO NOT commit real credentials or .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Docker & Database Settings (Local Docker PostgreSQL or Remote Managed DB)
# ------------------------------------------------------------------------------
POSTGRES_VERSION=16-alpine

# Discrete Database Connection Variables
# Use 'localhost' when running the Node app outside Docker (local dev)
# Use 'postgres' (service name) if running Node backend inside a Docker network
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=healthcare_db

# Full Database Connection URL (Ensure password with special characters is URL-encoded)
DATABASE_URL=postgres://postgres:replace_with_a_strong_password@localhost:5432/healthcare_db

# ------------------------------------------------------------------------------
# 3. Connection Pool Configuration
# ------------------------------------------------------------------------------
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 4. SSL / TLS Configuration (Cloud Providers: Render, Supabase, Neon, AWS RDS)
# ------------------------------------------------------------------------------
# Set to 'false' for local Docker development
# Set to 'true' or 'require' when connecting to cloud-managed PostgreSQL
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 5. JWT Authentication Configuration (Phase 2)
# ------------------------------------------------------------------------------
# Must be a cryptographically random secret of at least 32 characters in production.
# Generate on Linux/macOS/Git Bash with: openssl rand -base64 32
# Or in Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_cryptographically_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=1h
