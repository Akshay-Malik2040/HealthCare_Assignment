{
  "info": {
    "_postman_id": "healthcare-backend-api-v1",
    "name": "Healthcare Management REST API",
    "description": "Comprehensive Postman collection for the Healthcare Management Backend REST API covering Authentication, Patient CRUD, Doctor CRUD, Patient-Doctor Mappings, and System Health Check endpoints.\n\n### Execution Order:\n1. Run **Health Check** to verify server and database connectivity.\n2. Run **Register User** to create a test account.\n3. Run **Login User** — this automatically captures the JWT token into the `{{token}}` collection variable.\n4. Run **Patient Management** requests (Create, List, Get, Update).\n5. Run **Doctor Management** requests (Create, List, Get, Update).\n6. Run **Patient-Doctor Mapping** requests (Create, List, Get, Update).\n7. Run **Delete Patient** & **Delete Doctor** to verify cleanup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "doctorId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "mappingId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health",
      "item": [
        {
          "name": "API Root Discovery",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": ["{{baseUrl}}"],
              "path": ["api"]
            },
            "description": "Returns operational status and available endpoint discovery map."
          }
        },
        {
          "name": "Database Readiness Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Probes database pool connectivity and latency."
          }
        },
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health?check=liveness",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"],
              "query": [
                {
                  "key": "check",
                  "value": "liveness"
                }
              ]
            },
            "description": "Lightweight container liveness check."
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"User created with sanitized response\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data).to.not.have.property('password_hash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Sarah Connor\",\n  \"email\": \"sarah.connor@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", ""]
            },
            "description": "Registers a new user and hashes their password with bcrypt."
          }
        },
        {
          "name": "Login User (Captures JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Capture JWT token\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "    pm.collectionVariables.set(\"token\", json.data.token);",
                  "    console.log(\"Captured token:\", json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah.connor@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            },
            "description": "Authenticates user and saves JWT token to {{token}} collection variable."
          }
        },
        {
          "name": "Get Authenticated Profile (Me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Verifies token validity and returns authenticated identity."
          }
        }
      ]
    },
    {
      "name": "3. Patients",
      "item": [
        {
          "name": "Create Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set(\"patientId\", json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"age\": 28,\n  \"gender\": \"male\",\n  \"address\": \"Delhi, India\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/patients/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", ""]
            },
            "description": "Creates a new patient record owned by the authenticated caller."
          }
        },
        {
          "name": "List Patients",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", ""]
            },
            "description": "Lists all patient records owned by the authenticated user."
          }
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/{{patientId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "{{patientId}}", ""]
            },
            "description": "Retrieves an owned patient by ID (returns 404 for other users' patients)."
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"age\": 29,\n  \"gender\": \"male\",\n  \"address\": \"Mumbai, India\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/patients/{{patientId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "{{patientId}}", ""]
            },
            "description": "Updates an owned patient with full replacement semantics."
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/{{patientId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "{{patientId}}", ""]
            },
            "description": "Deletes an owned patient (cascades to their doctor mappings)."
          }
        }
      ]
    },
    {
      "name": "4. Doctors",
      "item": [
        {
          "name": "Create Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set(\"doctorId\", json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Neha Sharma\",\n  \"specialization\": \"Cardiology\",\n  \"email\": \"neha.sharma@example.com\",\n  \"phone\": \"+91-9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", ""]
            },
            "description": "Creates a doctor in the shared catalog."
          }
        },
        {
          "name": "List All Doctors",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", ""]
            },
            "description": "Lists all doctors visible under the shared-doctor model."
          }
        },
        {
          "name": "Get Doctor by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{doctorId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{doctorId}}", ""]
            },
            "description": "Retrieves a doctor record by ID."
          }
        },
        {
          "name": "Update Doctor",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Neha Sharma\",\n  \"specialization\": \"Senior Cardiology Specialist\",\n  \"email\": \"neha.sharma@example.com\",\n  \"phone\": \"+91-9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{doctorId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{doctorId}}", ""]
            },
            "description": "Updates doctor fields using full replacement semantics."
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{doctorId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{doctorId}}", ""]
            },
            "description": "Deletes a doctor (fails with 409 if active assignments exist and RESTRICT is enforced)."
          }
        }
      ]
    },
    {
      "name": "5. Patient-Doctor Mappings",
      "item": [
        {
          "name": "Create Mapping (Assign Doctor to Patient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set(\"mappingId\", json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": {{patientId}},\n  \"doctor_id\": {{doctorId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mappings/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings", ""]
            },
            "description": "Assigns a doctor to an owned patient. Returns 409 if assignment already exists."
          }
        },
        {
          "name": "List Mappings for Caller's Patients",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mappings/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings", ""]
            },
            "description": "Lists all doctor assignments for patients owned by the authenticated caller."
          }
        },
        {
          "name": "Get Doctors Assigned to a Specific Patient",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mappings/{{patientId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings", "{{patientId}}", ""]
            },
            "description": "Retrieves all doctors assigned to patient_id. Returns 404 if patient is not owned by caller."
          }
        },
        {
          "name": "Delete Mapping",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mappings/{{mappingId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings", "{{mappingId}}", ""]
            },
            "description": "Deletes only the mapping record. Patient and doctor records remain intact."
          }
        }
      ]
    }
  ]
}
